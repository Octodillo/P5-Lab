{
  "tasks": {
    "dev": "deno run --allow-read=./src,./static,$HOME/.local/share/deno-wasmbuild --allow-net=0.0.0.0:8000 --allow-write=./src,./static --allow-env server.ts",
    "serve": "deno run --allow-read=./src,./static,$HOME/.local/share/deno-wasmbuild --allow-net=0.0.0.0:8000 --allow-env server.ts"
  },
  "imports": {
    "events": "https://esm.sh/jsr/@denosaurs/event",
    "p5": "https://esm.sh/p5@1.7.0",
    "@types/p5": "https://esm.sh/@types/p5@1.7.3"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2022", "deno.ns"],
    "strict": true,
    "checkJs": false
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "unstable": ["bundle"]
}
